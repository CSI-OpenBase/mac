{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open.aicsi.cn/schemas/workspace-v1.json",
  "title": "CSI OpenBase 工作区清单",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "slug", "display_name", "platform", "profile_url", "database", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 120},
    "platform": {"enum": ["douyin"]},
    "profile_url": {"type": "string"},
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {"name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"}}
    },
    "created_at": {"type": "string", "format": "date-time"}
  }
}
